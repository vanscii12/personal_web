/img/
test/img/
public/img-webp/
*.zip
*.7z
*.tar.gz
*.rar
test/

# ===================================
# Footprint 位置历史（私人数据：原始导出、边界下载，以及由它们生成的文件）
# ===================================
apps/footprint/data/
public/data/footprint/
# 兜底：导出的 CSV 放错目录时也不会被提交
backUpData*.csv

# ===================================
# 本地工具与 AI Agent 状态
# ===================================
.claude/
.codegraph/
CLAUDE.md
design/.user_uploaded/
design/**/*.metadata.json
/scratch/

# ===================================
# Python 脚本缓存
# ===================================
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ===================================
# LaTeX / Typst 编译产物
# ===================================
*.aux
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
/main.pdf
test/*.pdf

# ===================================
# 环境变量与日志
# ===================================
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

